---
import Base from '../../layouts/Base.astro';
import BookCover from '../../components/BookCover.astro';
import Locations from '../../components/Locations.astro';
import { books, adventureSpecs, type Book } from '../../data/site';

export function getStaticPaths() {
  return books.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props as { book: Book };
const others = books.filter((b) => b.slug !== book.slug).slice(0, 4);
---

<Base title={book.title} description={book.tagline}>
  <section class="section">
    <div class="container product">
      <BookCover book={book} size="lg" />
      <div>
        <a class="back" href="/ten-dollar-adventures">← All $10 Adventures</a>
        {book.workingTitle && <p class="wip">🚧 Working title — under construction</p>}
        <h1>{book.title}</h1>
        <p class="tagline">{book.tagline}</p>
        <p class="price">$10</p>
        <p>{book.blurb}</p>
        <dl class="specs">
          <div><dt>Players</dt><dd>{adventureSpecs.players}</dd></div>
          <div><dt>Play time</dt><dd>{adventureSpecs.playTime}</dd></div>
          <div><dt>DM prep</dt><dd>{adventureSpecs.prep}</dd></div>
          <div><dt>In the box</dt><dd>{adventureSpecs.includes}</dd></div>
        </dl>
        <h3>Credits</h3>
        <dl class="specs credits">
          <div><dt>Story</dt><dd>{book.credits?.story ?? 'Coming soon'}</dd></div>
          <div><dt>Art</dt><dd>{book.credits?.art ?? 'Coming soon'}</dd></div>
          <div><dt>Printing</dt><dd>{book.credits?.printing ?? 'Coming soon'}</dd></div>
        </dl>
        <h3>How to buy</h3>
        <p>
          Pick up a copy at any of the stores below — just ask at the counter for <em>{book.title}</em>.
          Want a copy shipped, or bulk copies for your group? <a href="/contact">Get in touch</a>.
        </p>
        <a class="btn" href="#where-to-buy">Where to buy ↓</a>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="where-to-buy">
    <div class="container">
      <h2>Where to buy</h2>
      <Locations />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>More adventures</h2>
      <ul class="more">
        {
          others.map((b) => (
            <li>
              <a href={`/ten-dollar-adventures/${b.slug}`}>
                <BookCover book={b} />
                <span>{b.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .product {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr;
    gap: 3.5rem;
    align-items: start;
  }
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .wip {
    width: fit-content;
    margin: 0 0 0.75rem;
    padding: 0.2rem 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: #f2c230;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  .price {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 0.1rem 0.9rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    transform: rotate(-3deg);
  }
  .specs {
    margin: 1.5rem 0;
    border-top: 1px dashed var(--line);
  }
  .specs div {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--line);
  }
  .specs dt {
    font-weight: 600;
    min-width: 8rem;
  }
  .specs dd {
    margin: 0;
  }
  .credits {
    margin-top: 0.5rem;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .more a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .more span {
    display: block;
    margin-top: 0.8rem;
  }
  @media (max-width: 820px) {
    .product {
      grid-template-columns: 1fr;
    }
    .product > :first-child {
      max-width: 280px;
    }
  }
</style>
