---
import Base from '../../layouts/Base.astro';
import BookCover from '../../components/BookCover.astro';
import BookCarousel from '../../components/BookCarousel.astro';
import Locations from '../../components/Locations.astro';
import { books, adventureSpecs, locationsUnderConstruction } from '../../data/site';

const featured = books.find((b) => b.featured) ?? books[0];
---

<Base title="$10 Adventures" description="Premade D&D one-shots, ready to run in 30 minutes, for ten bucks.">
  <!-- 2/3 · 1/3 intro -->
  <section class="section">
    <div class="container intro">
      <div>
        <p class="eyebrow">30 minute one-shots</p>
        <h1>What are $10 Adventures?</h1>
        <p class="lede">
          Premade D&amp;D one-shots built for busy DMs. Every adventure is ready to run in 30 minutes
          or less of prep — read it over lunch, run it that night.
        </p>
        <p>
          Each $10 Adventure comes with everything the table needs: tokens, maps, and five premade
          character sheets, so your players can sit down and start rolling. Perfect for game nights,
          new-player intros, or when your regular campaign needs a night off.
        </p>
        <ul class="facts">
          <li><strong>$10</strong> flat, every adventure</li>
          <li><strong>{adventureSpecs.players}</strong></li>
          <li><strong>{adventureSpecs.playTime}</strong> of play</li>
          <li><strong>≤30 min</strong> DM prep</li>
        </ul>
      </div>
      <a class="feature" href={`/ten-dollar-adventures/${featured.slug}`}>
        <BookCover book={featured} size="lg" />
        <span>Latest: {featured.title}</span>
      </a>
    </div>
  </section>

  <!-- Carousel -->
  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">The shelf</p>
      <h2>Pick your next adventure</h2>
      <p class="lede">Hover over a book to see how to grab a copy.</p>
      <BookCarousel />
    </div>
  </section>

  <!-- Where to buy -->
  <section class="section" id="where-to-buy">
    <div class="container">
      <p class="eyebrow">Where to buy</p>
      <h2>Find them on a shelf near you</h2>
      <p class="lede">
        {
          locationsUnderConstruction
            ? 'Local game store stockists are coming soon.'
            : '$10 Adventures are stocked at these friendly local game stores.'
        } Want them in your shop?
        <a href="/contact">Get in touch.</a>
      </p>
      <Locations />
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .facts li {
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    background: #fffdf8;
  }
  .feature {
    display: block;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    text-align: center;
  }
  .feature span {
    display: block;
    margin-top: 1rem;
  }
  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .feature {
      max-width: 280px;
      margin-inline: auto;
    }
  }
</style>
