---
import Base from '../layouts/Base.astro';
import BookCover from '../components/BookCover.astro';
import { books, portfolioUrl } from '../data/site';

const featured = books.find((b) => b.featured) ?? books[0];
const preview = books.slice(0, 3);
---

<Base>
  <!-- What is Big Ol' Bear Studios -->
  <section class="section hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Welcome to the den</p>
        <h1>Small studio. Big ol’ ideas.</h1>
        <p class="lede">
          Big Ol’ Bear Studios is a one-bear shop run out of Northern Colorado — making things I’d
          want to use myself: ready-to-run D&amp;D one-shots for the table, software that does its
          job and gets out of the way, and community events that get people building together.
        </p>
        <div class="actions">
          <a class="btn" href="/ten-dollar-adventures">Browse $10 Adventures</a>
          <a class="btn btn--ghost" href="/contact">Say hello</a>
        </div>
      </div>
      <img class="hero-logo" src="/images/logo.png" alt="Big Ol’ Bear Studios logo" width="1080" height="744" />
    </div>
  </section>

  <!-- $10 Adventures -->
  <section class="section section--alt">
    <div class="container split">
      <div>
        <p class="eyebrow">$10 Adventures</p>
        <h2>A whole one-shot for a ten-dollar bill.</h2>
        <p class="lede">
          Premade D&amp;D one-shots a DM can have ready to run in 30 minutes or less. Every adventure
          comes with tokens, maps, and five premade character sheets — just add 3–5 friends and an
          evening.
        </p>
        <p>Currently starring <strong>{featured.title}</strong> — {featured.tagline}</p>
        <a class="btn" href="/ten-dollar-adventures">See all the adventures →</a>
      </div>
      <ul class="mini-shelf">
        {
          preview.map((b) => (
            <li>
              <a href={`/ten-dollar-adventures/${b.slug}`} aria-label={b.title}>
                <BookCover book={b} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Consulting (minimal) -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Consulting</p>
      <h2>Need a hand with software?</h2>
      <p class="lede">
        Web apps, tooling, and data pipelines. The short version: tell me the problem, and I’ll
        help you solve it.
      </p>
      <div class="actions">
        <a class="btn" href="/consulting">Consulting</a>
        <a class="btn btn--ghost" href={portfolioUrl} target="_blank" rel="noopener">Portfolio ↗</a>
      </div>
    </div>
  </section>

  <!-- FoCodeathon teaser -->
  <section class="section teaser">
    <div class="container narrow">
      <p class="eyebrow">Coming soon</p>
      <h2>FoCodeathon</h2>
      <p class="lede">
        Something’s brewing in Fort Collins. A weekend of building, breaking, and pizza. Details
        are still in the oven.
      </p>
      <a class="btn" href="/focodeathon">Peek behind the tape →</a>
    </div>
  </section>
</Base>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-logo {
    width: 100%;
    height: auto;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .mini-shelf {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
  }
  .mini-shelf li:nth-child(2) {
    transform: translateY(-1.25rem);
  }
  .mini-shelf a {
    display: block;
    transition: transform 0.15s ease;
  }
  .mini-shelf a:hover {
    transform: rotate(-2deg) translateY(-4px);
  }
  .narrow {
    max-width: 760px;
  }
  .teaser {
    background: var(--ink);
    color: var(--paper);
  }
  .teaser .lede {
    color: #cfc7b8;
  }
  .teaser .btn {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  @media (max-width: 820px) {
    .hero-grid,
    .split {
      grid-template-columns: 1fr;
    }
    .hero-logo {
      order: -1;
      max-width: 380px;
    }
  }
</style>
