---
import { nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <img src="/images/logo.png" alt="Big Ol’ Bear Studios" width="180" height="124" />
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <p class="fine">© {year} Big Ol’ Bear Studios · Made in Colorado</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--ink);
    background: var(--paper-2);
    padding-block: 2.5rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  img {
    width: 140px;
    height: auto;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .fine {
    width: 100%;
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
</style>
