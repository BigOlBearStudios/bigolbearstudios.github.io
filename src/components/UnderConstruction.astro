---
interface Props {
  title: string;
  teaser?: string;
}
const { title, teaser = 'This corner of the den is still being built. Check back soon.' } = Astro.props;
---

<section class="section">
  <div class="container uc">
    <div class="tape" aria-hidden="true"></div>
    <img src="/images/logo-mark.png" alt="" width="320" height="164" />
    <p class="eyebrow">Under construction</p>
    <h1>{title}</h1>
    <p class="lede">{teaser}</p>
    <p class="lede">The bear is hard at work (hibernating between commits). In the meantime:</p>
    <div class="actions">
      <a class="btn" href="/">Back home</a>
      <a class="btn btn--ghost" href="/contact">Get in touch</a>
    </div>
    <div class="tape" aria-hidden="true"></div>
  </div>
</section>

<style>
  .uc {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .uc img {
    width: min(320px, 70%);
    height: auto;
    margin-block: 2rem 1.5rem;
  }
  .lede {
    margin-inline: auto;
  }
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-block: 1rem 2.5rem;
  }
  .tape {
    width: 100%;
    height: 22px;
    border: 2px solid var(--ink);
    background: repeating-linear-gradient(-45deg, var(--ink) 0 18px, #f2c230 18px 36px);
  }
</style>
